PORT=4000

# Origines frontend autorisées (séparées par des virgules)
FRONTEND_ORIGIN=http://localhost:5173

# JWT — IMPORTANT: utiliser une clé forte et unique en production (min 64 caractères)
JWT_SECRET=CHANGE_ME_USE_A_STRONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/prestation?retryWrites=true&w=majority

# Resend (envoi d'emails: réinitialisation de mot de passe, notifications)
# Clé API sur https://resend.com/api-keys — si absente, les emails ne sont pas
# envoyés et les liens apparaissent dans les logs serveur
RESEND_API_KEY=
# L'adresse doit appartenir à un domaine vérifié dans Resend (Domains → Add Domain)
MAIL_FROM=PrestaCI <no-reply@prestaci.com>

# Base publique du backend (URLs des fichiers uploadés). Ex: https://api.prestaci.com
PUBLIC_BASE_URL=http://localhost:4000

# GeniusPay — paiement en ligne des abonnements (Wave, Orange Money, MTN, Moov, carte)
# Clés : tableau de bord GeniusPay → Paramètres → API. pk_sandbox_/sk_sandbox_ pour tester,
# pk_live_/sk_live_ en production. Sans ces clés, le bouton « Payer en ligne » est masqué.
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=
# Secret whsec_… renvoyé UNE SEULE FOIS à la création du webhook. URL du webhook à déclarer :
#   https://<votre-backend>/api/paiements/webhook/geniuspay  (événements payment.*)
GENIUSPAY_WEBHOOK_SECRET=
# URL publique du frontend pour le retour après paiement (sinon 1re valeur de FRONTEND_ORIGIN)
FRONTEND_URL=

# Banque d'images pour remplir le fil « Découvrir » (admin → Modèles → Pack de lancement).
# La première clé présente est utilisée :
# Pixabay (recommandé) — clé gratuite et immédiate : compte sur pixabay.com, la clé
# s'affiche sur https://pixabay.com/api/docs/ . Les images sont copiées sur notre serveur.
PIXABAY_API_KEY=
# Unsplash — https://unsplash.com/oauth/applications (50 requêtes/h en mode démo)
UNSPLASH_ACCESS_KEY=
# Pexels — délivrance de nouvelles clés suspendue en 2026
PEXELS_API_KEY=
